{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "iou.fm Standard-Berechtigungen für das Hauptfenster.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "process:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.myshopify.com/*" },
        { "url": "https://api.frankfurter.app/*" }
      ]
    }
  ]
}
