{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iou.fm",
  "version": "0.2.46",
  "identifier": "com.forkandmerge.ioufm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "iou.fm",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/StefanTheSpider/iou.fm/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDMDJEMDU3NTEzREQ4Q0YKUldUUDJEMVJWOUFDM0p3dXRjWFJmeEJja0NHdzdydlZkamg0T0R5UGFmUGJIY0hxUWY0Q3hGWWsK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Finance",
    "publisher": "fork and merge UG",
    "shortDescription": "IBAN · Order · Überweisung",
    "longDescription": "iou.fm – lokale, Ende-zu-Ende verschlüsselte SEPA-Zahlungs-App (Löhne + Erstattungen). Von fork and merge UG.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": { "languages": ["German", "English"] }
    }
  }
}
